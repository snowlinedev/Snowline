<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hourly pg_dump of every live Snowline store (decision c68ec655). A
     one-shot timer — NOT KeepAlive: it dumps, verifies, prunes and exits; the
     timer fires it again on schedule, so a failed run is simply a skipped run
     (no retry storm). Installed by ops/hub/install-daemons.sh (which also
     retires the older per-user LaunchAgent of the same label); see
     docs/ops/hub-daemons.md "DB backups".

     A system LaunchDaemon, like the services and the autocut timer, so a
     backup is taken whether or not anyone is logged in. It runs as
     UserName=seanlynch with HOME set so pg_dump reaches the owner's Postgres
     role over the local socket and the dumps land in the owner's iCloud
     Drive folder (iCloud syncs them up the next time a login session is
     active; after a FileVault boot that is always the case).

     RunAtLoad is true: loading the unit takes one backup immediately, which
     proves the whole path end to end (dump written, destination reachable).
     A dump of all stores takes a few seconds. No WorkingDirectory: the script
     does not use it, and a missing directory would make launchd refuse to
     spawn (EX_CONFIG) — exactly the silent-failure mode this unit exists to
     avoid. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.snowline.backup</string>
    <key>UserName</key>
    <string>seanlynch</string>
    <key>GroupName</key>
    <string>staff</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/seanlynch/Projects/snowline-platform/ops/hub/snowline-backup.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/seanlynch</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <!-- Where dumps land. Default in the script is iCloud Drive (off-machine
             durability for free). Set this to redirect — e.g. a tailnet rsync
             target or an external volume. Retention defaults to 30 days;
             override with SNOWLINE_BACKUP_RETENTION_DAYS. The store list can
             be overridden with SNOWLINE_BACKUP_DBS (space-separated); the
             script warns and exits 1 if a configured store is left out. -->
        <key>SNOWLINE_BACKUP_DIR</key>
        <string>/Users/seanlynch/Library/Mobile Documents/com~apple~CloudDocs/Snowline/db-backups</string>
    </dict>
    <!-- Hourly (3600s). The stores change throughout the day (every work item,
         decision, artifact, memory, musher run), so cap losable work at about
         an hour. StartInterval fires from load and catches up once after a
         sleep/wake if an interval elapsed. Six dumps total ~8 MB, so a month
         of hourly history is cheap. -->
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/seanlynch/Library/Logs/snowline-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/seanlynch/Library/Logs/snowline-backup.log</string>
</dict>
</plist>
