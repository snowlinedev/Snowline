<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.snowline.backup</string>

    <!-- The PER-USER form of the hourly backup timer (gui/501). The system
         LaunchDaemon under ../launchdaemons/ is the preferred unit; this one
         is what install-daemons.sh / uninstall-daemons.sh fall back to
         (restore_agent in launchdaemons/lib.sh) when the daemon cannot run
         in the system domain (e.g. no access to the owner's iCloud folder)
         and no previously-installed agent plist is left to restore. Tracked
         here so the fallback never depends on an untracked file — the #220
         root cause. Same script, same destination, same cadence; see
         docs/ops/hub-daemons.md "DB backups".
         Manual install: cp to ~/Library/LaunchAgents/ then
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.snowline.backup.plist -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/seanlynch/Projects/snowline-platform/ops/hub/snowline-backup.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>3600</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/seanlynch/Library/Logs/snowline-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/seanlynch/Library/Logs/snowline-backup.log</string>
</dict>
</plist>
