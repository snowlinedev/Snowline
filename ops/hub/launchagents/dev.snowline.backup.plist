<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.snowline.backup</string>

    <!-- Hourly pg_dump of every live Snowline store (decision c68ec655). The
         owner's PER-USER LaunchAgent (gui/501), installed and (re)loaded by
         ops/hub/install-backup-agent.sh from this tracked file — the #220 root
         cause was this unit's files living outside main.

         A per-user agent on purpose, not a system daemon like the services:
         a dump needs the owner's session anyway (Postgres on the hub is the
         owner's per-user agent; iCloud Drive syncs per session), so the
         system domain would add no coverage and would raise a TCC question
         for writing into ~/Library/Mobile Documents with no session to
         answer it. See docs/ops/hub-daemons.md "DB backups".

         One-shot, NOT KeepAlive: it dumps, verifies, prunes and exits; the
         timer fires it again on schedule, so a failed run is simply a
         skipped run (no retry storm). No RunAtLoad: the installer proves
         the unit by firing one run through launchd and reading its exit
         code and evidence, and a load must not start a dump behind the
         operator's back (StartInterval fires from load, so the first timed
         run is an hour after loading). No WorkingDirectory: the script does not use
         it, and a missing directory would make launchd refuse to spawn
         (EX_CONFIG) — the silent-failure mode this unit exists to avoid.
         The script sets its own PATH.

         Overrides the script accepts, in ~/.config/snowline/backup.env (never
         here: the installer replaces this file with the tracked copy):
           SNOWLINE_BACKUP_DIR — where dumps land (default: iCloud Drive; a
             non-iCloud path skips the iCloud root check and must already
             exist — it is never created);
           SNOWLINE_BACKUP_RETENTION_DAYS — default 30;
           SNOWLINE_BACKUP_DBS — space-separated store list (default: every
             live snowline_* store from the catalog).
         Manual install, if ever needed: cp to ~/Library/LaunchAgents/ then
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/dev.snowline.backup.plist -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/seanlynch/Projects/snowline-platform/ops/hub/snowline-backup.sh</string>
    </array>

    <!-- launchd's default is 5 s from SIGTERM to SIGKILL; the script's TERM
         handler can be deferred by a foreground command (a Postgres wait,
         a folder walk) for a few seconds, and it must get to log itself -->
    <key>ExitTimeOut</key>
    <integer>30</integer>
    <key>StartInterval</key>
    <integer>3600</integer>

    <key>StandardOutPath</key>
    <string>/Users/seanlynch/Library/Logs/snowline-backup.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/seanlynch/Library/Logs/snowline-backup.log</string>
</dict>
</plist>
