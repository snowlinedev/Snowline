# snowline platform — packaged spoke posture (macOS distribution spec §5/§6,
# promoted from ops/roam/env.roam.example). Rendered by `snowline stack sync`
# into ~/.config/snowline/platform.env — THIS FILE IS YOURS: sync never
# overwrites an existing copy, it only reports template drift for you to
# review by hand.
#
# host/port are NOT read from here — they are baked into the launchd plist's
# ProgramArguments (spec §5 step 4: sync execs `current/bin/uvicorn` with
# `--host 127.0.0.1 --port <N>` directly).

# --- identity ---------------------------------------------------------------
export SNOWLINE_INSTANCE_ID=$instance_id

# --- the full trusted set (roam §5.1 — state it IN FULL; it REPLACES the
# platform's default when set) ------------------------------------------------
export SNOWLINE_TRUSTED_CIDRS="$trusted_cidrs"

# --- platform (the composed surface + scope stream) -------------------------
export SNOWLINE_PLATFORM_DATABASE_URL="postgresql+psycopg:///snowline_platform"
export SNOWLINE_PLATFORM_URL="http://127.0.0.1:$platform_port"
export SNOWLINE_REPLICATION_SOURCE_ID=$instance_id.platform
export SNOWLINE_REPLICATION_INTERVAL=30

# dashboard dist — ALWAYS set by sync (spec §2.2 / risk 2): the code's
# checkout-relative fallback points into site-packages nonsense on a wheel
# install and must never be relied on.
export SNOWLINE_DASHBOARD_DIST="$dashboard_dist"

# --- pairing CLI convenience (spec §6 — pairing itself is NOT sync's job;
# `snowline stack bootstrap-spoke`, item 71317cd6, uses this) ----------------
# the primary's tailnet address, filled in from ~/.config/snowline/stack.json:
# PRIMARY=$primary_tailnet_address
