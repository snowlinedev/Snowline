# snowline failover front — packaged spoke posture (issue #260). Rendered by
# `snowline stack sync` into ~/.config/snowline/front.env — THIS FILE IS
# YOURS: sync never overwrites an existing copy, it only reports template
# drift for you to review by hand.
#
# The front is a loopback-only reverse proxy on 127.0.0.1:$front_port (the
# hub gateway's own port, so Claude Code's MCP entry reads the same path as
# the hub's): every request goes to the HUB while its /health answers 200,
# else to the LOCAL spoke platform, with hysteresis. It serves GET
# /front/health itself. See docs/ops/roam-runbook.md "Failover front".
#
# host/port are NOT read from here — they are baked into the launchd plist's
# ProgramArguments, exactly like the services (SNOWLINE_FRONT_BIND is only
# read by `snowline front` run by hand).

# --- upstreams --------------------------------------------------------------
# the hub gateway, from ~/.config/snowline/stack.json (primary_gateway_url):
export SNOWLINE_FRONT_HUB_URL="$hub_url"
# this spoke's own platform:
export SNOWLINE_FRONT_SPOKE_URL="$spoke_url"

# --- probing + hysteresis (defaults shown) ----------------------------------
# export SNOWLINE_FRONT_PROBE_INTERVAL=5      # seconds between hub /health probes
# export SNOWLINE_FRONT_PROBE_TIMEOUT=2       # a probe slower than this FAILS
# export SNOWLINE_FRONT_FAIL_THRESHOLD=2      # consecutive failures -> spoke
# export SNOWLINE_FRONT_RECOVER_THRESHOLD=6   # consecutive successes -> hub
# export SNOWLINE_FRONT_READ_TIMEOUT=600      # per-read on a forwarded request; 0 = none

# --- debugging --------------------------------------------------------------
# pin the upstream (no flips; /front/health still reports hub_healthy), then
# `launchctl kickstart -k gui/$$(id -u)/dev.snowline.front`:
# export SNOWLINE_FRONT_FORCE_UPSTREAM=spoke
