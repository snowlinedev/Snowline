# snowline governance — packaged spoke posture (macOS distribution spec §5/§6,
# promoted from ops/roam/env.roam.example). Rendered by `snowline stack sync`
# into ~/.config/snowline/governance.env — THIS FILE IS YOURS: sync never
# overwrites an existing copy, it only reports template drift.
#
# NOTE: this process gets its OWN SNOWLINE_REPLICATION_SOURCE_ID (below) — a
# single global value across services would fork stream identity (roam §3).

# --- identity ---------------------------------------------------------------
export SNOWLINE_INSTANCE_ID=$instance_id

# --- the full trusted set (state it IN FULL; it REPLACES the default) -------
export SNOWLINE_TRUSTED_CIDRS="$trusted_cidrs"

# --- governance plugin -------------------------------------------------------
export SNOWLINE_GOVERNANCE_DATABASE_URL="postgresql+psycopg:///snowline_governance"
export SNOWLINE_GOVERNANCE_BASE_URL="http://127.0.0.1:$governance_port"
export SNOWLINE_PLATFORM_URL="http://127.0.0.1:$platform_port"
export SNOWLINE_REPLICATION_SOURCE_ID=$instance_id.governance
export SNOWLINE_REPLICATION_INTERVAL=30
