# snowline pm — packaged spoke posture (macOS distribution spec §5/§6/§8: pm
# is NEW to the packaged spoke — ops/roam predates pm as a spoke service).
# Rendered by `snowline stack sync` into ~/.config/snowline/pm.env — THIS
# FILE IS YOURS: sync never overwrites an existing copy, it only reports
# template drift.
#
# NOTE: this process gets its OWN SNOWLINE_REPLICATION_SOURCE_ID (below) — a
# single global value across services would fork stream identity (roam §3).

# --- identity ---------------------------------------------------------------
export SNOWLINE_INSTANCE_ID=$instance_id

# --- the full trusted set (state it IN FULL; it REPLACES the default) -------
export SNOWLINE_TRUSTED_CIDRS="$trusted_cidrs"

# --- pm plugin ----------------------------------------------------------------
export SNOWLINE_PM_DATABASE_URL="postgresql+psycopg:///snowline_pm"
export SNOWLINE_PM_BASE_URL="http://127.0.0.1:$pm_port"
export SNOWLINE_PLATFORM_URL="http://127.0.0.1:$platform_port"
# role selection (spec §6): the packaged channel only ever installs a spoke.
export SNOWLINE_PM_ROLE=spoke
export SNOWLINE_REPLICATION_SOURCE_ID=$instance_id.pm
export SNOWLINE_REPLICATION_INTERVAL=30
